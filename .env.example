# Copiá este archivo como .env y completá los valores.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# --- Supabase ---
# URL y service_role key del proyecto (la misma base que usa gradebook-api).
# La service_role key es secreta: el worker lee asistencias/estudiantes/clases
# y escribe el estado de envío en `asistencias`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=tu-service-role-key

# --- Firma de QStash ---
# Signing keys del endpoint de QStash (consola de Upstash → QStash → signing keys).
# Se usan para verificar el JWT del header Upstash-Signature. NEXT admite la
# rotación de la vigente. Vacías = verificación deshabilitada (modo dev; los
# endpoints aceptan requests sin firma con un warning en el log).
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Envío de emails (reintentos) ---
# Pausa entre emails del lote (ms) y reintentos ante errores transitorios de red
# del SMTP (throttling de Gmail) y de Supabase al persistir el estado del envío.
ASISTENCIA_EMAILS_PAUSA_MS=500
ASISTENCIA_EMAILS_MAX_REINTENTOS=2
ASISTENCIA_EMAILS_BACKOFF_MS=2000
ASISTENCIA_DB_MAX_REINTENTOS=3
ASISTENCIA_DB_BACKOFF_MS=100

# --- Email (Flask-Mail / SMTP) ---
# Si MAIL_USERNAME/MAIL_PASSWORD están vacíos (o MAIL_SUPPRESS_SEND=true), NO se
# envía: se loguea el link/password (modo dev). Con Gmail, MAIL_PASSWORD es un
# "App Password" (no la clave de la cuenta).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente. Si se deja vacío, usa MAIL_USERNAME (Gmail exige que el from sea la
# cuenta autenticada).
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false
